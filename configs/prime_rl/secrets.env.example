# Copy to configs/prime_rl/secrets.env on the Prime box.
# Do not commit the real secrets.env file.

# Required for private Hugging Face datasets/models.
HF_TOKEN=hf_xxx

# Optional, but recommended for training curves and rollout tables.
WANDB_API_KEY=xxx

# Optional for Prime CLI/API flows. `prime login` may store this for you instead.
PRIME_API_KEY=xxx
